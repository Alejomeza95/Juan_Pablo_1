rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /documents/{allPaths=**} {
      // Cualquier usuario autenticado puede descargar los archivos
      allow read: if request.auth != null;
      // Solo el administrador puede subir o borrar archivos
      allow write: if request.auth != null && request.auth.token.email == 'diegoalejandro.narvaezmeza95@gmail.com';
    }
  }
}
